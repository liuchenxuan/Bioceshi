{"version":"4.0","code":"9Q5F5T","matchId":"om_9q5f5t_mvw78icg","cat":"duel","mode":"sync","modeLabel":"线上同题抢答","maxPlayers":2,"roundsTotal":7,"secPerQ":12,"bonusSec":5,"rated":true,"scopeLabel":"全库综合","seed":1673129444,"createdAt":1793438934496,"updatedAt":1793438934496,"hostId":"0601","phase":"lobby","countdownAt":0,"seats":[{"id":"0601","name":"曹子涵","cls":"6","no":"1","rating":1000,"tierLabel":"青苗","seat":0,"pubJwk":{"crv":"P-256","ext":true,"key_ops":["verify"],"kty":"EC","x":"tMUy1mqpywsRbj8l45oh5nCXI8zFnvor99tX0gdh2HU","y":"s5Zhmq9J9hZHkNoNKn1AqRIr1fLHwsev5Uj9cfH-eNI"},"joinedAt":1793438934496}],"qDeck":[{"id":"mv9pk9oama73nxj","stem":"过敏反应是由于免疫系统的免疫自稳功能过强而引起的疾病。","ans":false,"ana":"免疫系统的功能包括免疫防御（抵御外来病原体）、免疫自稳（清除自身衰老、损伤细胞）、免疫监视（清除异常细胞）；过敏反应是机体对过敏原过度敏感，属于免疫防御功能过强，而非免疫自稳功能过强，表述错误。","book":"选择性必修1 稳态与调节","kps":["过敏反应","免疫防御","免疫自稳","免疫监视"],"imgs":[]},{"id":"mv9pk9o90stgzgn","stem":"细胞分化导致基因的选择性表达。","ans":false,"ana":"因果关系颠倒；基因的选择性表达是细胞分化的根本原因，细胞分化是基因选择性表达的结果，并非细胞分化导致基因选择性表达，表述错误。","book":"必修1 分子与细胞","kps":["细胞分化","基因选择性表达","因果关系"],"imgs":[]},{"id":"mv9pk9oaqultzqo","stem":"任何生态系统都需要不断得到来自系统外的能量补充，以便维持生态系统的正常功能。","ans":true,"ana":"生态系统中能量流动是单向流动、逐级递减的，一部分能量会以热能形式散失，无法被重新利用，因此需要不断从系统外获得能量补充（如太阳能、人工输入的能量），才能维持生态系统的正常运转，表述正确。","book":"选择性必修2 生物与环境","kps":["生态系统","能量补充","能量流动","单向流动","逐级递减"],"imgs":[]},{"id":"mv9peeb4nzmuuq3","stem":"向泡菜坛盖边沿的水槽中注满水形成内部无菌环境","ans":false,"ana":"向泡菜坛盖边沿水槽注满水，目的是形成密封环境，隔绝空气，为乳酸菌无氧呼吸提供条件，并非形成无菌环境（泡菜坛内本身有乳酸菌等微生物），表述错误。","book":"选择性必修3 生物技术与工程","kps":["泡菜制作","乳酸菌","无氧环境"],"imgs":[]},{"id":"mv9peeb4bvhb62u","stem":"艾弗里等人的肺炎链球菌转化实验不仅证明了遗传物质是DNA，还证明了DNA可以在同种生物的不同个体之间转移","ans":true,"ana":"艾弗里实验中，将S型菌的DNA与R型菌混合，R型菌转化为S型菌，既证明了DNA是遗传物质，也证明了S型菌的DNA可转移到R型菌（同种生物不同个体）中，表述正确。","book":"必修2 遗传与进化","kps":["艾弗里","肺炎链球菌转化实验","DNA是遗传物质","DNA转移"],"imgs":[]},{"id":"mv9pk9o94mw3898","stem":"按基因的自由组合定律，两对相对性状的纯合体杂交得F1，F1自交得F2，则F2中表现型与亲本表现型不同的个体所占的理论比为6/16。","ans":false,"ana":"两对相对性状的纯合体杂交，亲本有两种组合方式：①双显性纯合（AABB）×双隐性纯合（aabb），F1为AaBb，F2中表现型与亲本不同的个体为单显性（A_bb、aaB_），所占比例为6/16；②单显性纯合（AAbb）×单显性纯合（aaBB），F1为AaBb，F2中表现型与亲本不同的个体为双显性（A_B_）和双隐性（aabb），所占比例为10/16。题干未明确亲本组合，因此“6/16”表述绝对，错误。","book":"必修2 遗传与进化","kps":["基因自由组合定律","纯合体杂交","F1","F2","表现型","亲本组合"],"imgs":[]},{"id":"mv9peeb3aww22w0","stem":"葡萄糖转化为乙醇所需的酶既存在于细胞质基质，也存在于线粒体","ans":false,"ana":"葡萄糖转化为乙醇是无氧呼吸过程，无氧呼吸全程在细胞质基质中进行，所需的酶仅存在于细胞质基质，线粒体中无相关酶，表述错误。","book":"必修1 分子与细胞","kps":["无氧呼吸","酶的存在部位"],"imgs":[]},{"id":"mv9peeb4ozfo5y9","stem":"寒冷环境下，肾上腺皮质分泌的肾上腺素增加，使代谢活动增强，产热增加","ans":false,"ana":"肾上腺素是由肾上腺髓质分泌的，并非肾上腺皮质；寒冷环境下，肾上腺素分泌增加，促进细胞代谢，增加产热，表述错误。","book":"选择性必修1 稳态与调节","kps":["体温调节","肾上腺素","肾上腺髓质","产热"],"imgs":[]},{"id":"mv9peeb3wx7y5rv","stem":"提高培养基中生长素和细胞分裂素的比值，有利于诱导生根","ans":true,"ana":"植物组织培养中，生长素与细胞分裂素的比值影响分化方向：比值高时，有利于诱导根的分化；比值低时，有利于诱导芽的分化；比值适中时，促进愈伤组织形成，表述正确。","book":"选择性必修3 生物技术与工程","kps":["植物组织培养","生长素","细胞分裂素","根芽分化"],"imgs":[]},{"id":"mv9peeb3iy69vb4","stem":"酸奶制作过程中，后期低温处理可产生大量乳酸杆菌","ans":false,"ana":"乳酸杆菌是嗜温菌，适宜发酵温度为38～42℃，低温会抑制乳酸杆菌的繁殖，无法产生大量乳酸杆菌，后期低温处理的目的是终止发酵、保存酸奶，表述错误。","book":"选择性必修3 生物技术与工程","kps":["泡菜制作","乳酸杆菌","发酵条件"],"imgs":[]},{"id":"mv9pk9oaukyzfm9","stem":"细胞体积减小时相对表面积增大，细胞与外界物质交换的效率提升。","ans":true,"ana":"细胞相对表面积=表面积/体积，细胞体积越小，相对表面积越大；相对表面积越大，细胞与外界环境接触的面积越大，物质交换的效率越高，表述正确。","book":"必修1 分子与细胞","kps":["细胞体积","相对表面积","物质交换效率"],"imgs":[]},{"id":"mv9pk9o9xv0mtyr","stem":"胆固醇是构成动植物细胞膜的重要成分，在人体内还参与血液中脂质的运输。","ans":false,"ana":"胆固醇是构成动物细胞膜的重要成分，植物细胞膜中不含胆固醇；其在人体内的功能包括参与血液中脂质的运输，题干中“动植物细胞膜”表述错误。","book":"必修1 分子与细胞","kps":["胆固醇","动物细胞膜","植物细胞膜","脂质运输"],"imgs":[]},{"id":"mv9peeb4km24keg","stem":"右图甲、乙、丙和淋巴液共同构成细胞与外界环境进行物质交换的媒介","ans":false,"ana":"细胞与外界环境进行物质交换的媒介是内环境，内环境包括血浆、组织液和淋巴液；题干中未明确甲、乙、丙的具体成分，若甲、乙、丙不代表血浆和组织液，则无法构成内环境，因此表述错误（结合常见题型，甲、乙、丙通常为血浆、组织液、细胞内液，细胞内液不属于内环境）。","book":"选择性必修1 稳态与调节","kps":["内环境","物质交换媒介","血浆","组织液","淋巴液"],"imgs":["data:image/jpeg;base64,"]},{"id":"mv9pk9o9vbbtutd","stem":"一个符合遗传平衡的群体，无论是自交还是相互交配，其基因频率及基因型频率都不再发生改变。","ans":false,"ana":"符合遗传平衡的群体，相互交配时，基因频率和基因型频率均保持不变；但自交时，基因型频率会发生改变（纯合子比例升高，杂合子比例降低），基因频率仍保持不变，因此“无论是自交还是相互交配，基因型频率都不改变”表述错误。","book":"必修2 遗传与进化","kps":["遗传平衡","基因频率","基因型频率","自交","相互交配"],"imgs":[]},{"id":"mv9pk9oath2384l","stem":"某同学利用塑料片、曲别针、扭扭棒、牙签、橡皮泥、铁丝等材料制作DNA双螺旋结构模型，制成的模型上下粗细相同，是因为A---T碱基对与G---C碱基对的形状和直径相同。","ans":true,"ana":"DNA双螺旋结构中，A与T之间形成2个氢键，G与C之间形成3个氢键，虽然氢键数量不同，但A---T碱基对和G---C碱基对的空间形状和直径相同，因此DNA双螺旋模型上下粗细一致，表述正确。","book":"必修2 遗传与进化","kps":["DNA双螺旋结构模型","A-T碱基对","G-C碱基对","形状","直径"],"imgs":[]},{"id":"mv9peeb48vvls7g","stem":"树突状细胞能够处理和呈递抗原，淋巴细胞不能呈递抗原","ans":false,"ana":"树突状细胞是专职抗原呈递细胞，可处理和呈递抗原；部分淋巴细胞也能呈递抗原（如B淋巴细胞可呈递抗原给T细胞），表述错误。","book":"选择性必修1 稳态与调节","kps":["抗原呈递细胞","树突状细胞","B淋巴细胞"],"imgs":[]},{"id":"mv9peeb4cx08e20","stem":"鉴别细胞的死活时，台盼蓝能将代谢旺盛的动物细胞染成蓝色","ans":false,"ana":"台盼蓝不能透过活细胞的细胞膜，可透过死细胞的细胞膜，因此死细胞会被染成蓝色，代谢旺盛的活细胞不会被染色，表述错误。","book":"必修1 分子与细胞","kps":["细胞膜的选择透过性","台盼蓝","细胞死活鉴别"],"imgs":[]},{"id":"mv9peeb438mdwzt","stem":"演替到稳定阶段的群落具有相对不变的物种组成和结构","ans":true,"ana":"群落演替到稳定阶段（顶极群落）时，群落的物种组成、种间关系和结构达到相对稳定的状态，不会发生明显变化，表述正确。","book":"选择性必修2 生物与环境","kps":["群落演替","稳定阶段","顶极群落","物种组成"],"imgs":[]}],"kpGroups":[{"name":"过敏反应","indices":[0],"reward":3},{"name":"细胞分化","indices":[1],"reward":3},{"name":"生态系统","indices":[2],"reward":3},{"name":"泡菜制作","indices":[3,9],"reward":3},{"name":"艾弗里","indices":[4],"reward":3},{"name":"基因自由组合定律","indices":[5],"reward":3},{"name":"无氧呼吸","indices":[6],"reward":3},{"name":"体温调节","indices":[7],"reward":3},{"name":"植物组织培养","indices":[8],"reward":3},{"name":"细胞体积","indices":[10],"reward":3},{"name":"胆固醇","indices":[11],"reward":3},{"name":"内环境","indices":[12],"reward":3}],"state":null}